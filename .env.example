# ==============================================================================
# IGNITE SPORTS CLUB — EST. 2026
# Environment Variables Example Template
# ==============================================================================
# NOTE: Copy this file to '.env.local' for local development:
#   cp .env.example .env.local
#
# SECURITY WARNING:
# NEVER commit '.env.local' or any file containing real API keys, tokens,
# database credentials, or Supabase service-role keys to version control.
# ==============================================================================

# Public Vite Variables (exposed to client-side bundle)
VITE_APP_TITLE="IGNITE SPORTS CLUB — EST. 2026"
VITE_CLUB_NAME="IGNITE SPORTS CLUB"
VITE_CLUB_EST="2026"

# Optional Backend / Database Integration (e.g., Supabase / Firebase)
# IMPORTANT: Use ONLY public anonymous keys here. NEVER expose service-role keys!
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key-placeholder"

# Club Contact & Notifications (Placeholder only)
VITE_CLUB_CONTACT_EMAIL="sportsclub@campus.edu"
VITE_CLUB_DISCORD_INVITE="https://discord.gg/your-club-invite"
